# ================================
# Backend OVP - Docker Ignore
# ================================

# Dependencias (se instalan en el contenedor)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos de entorno (usar variables de Docker)
.env
.env.local
.env.*.local

# Tests y desarrollo
tests/
*.test.js
jest.config.js
coverage/

# Documentación y archivos extras
*.md
!README.md
docs/

# Git
.git
.gitignore
.gitattributes

# Editor y IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Archivos temporales
tmp/
temp/

# Postman collections
*.postman_collection.json

# Scripts de desarrollo (opcional, descomenta si no los necesitas en producción)
# scripts/
