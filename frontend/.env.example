# ================================
# Frontend - Variables de Entorno
# ================================

# URL de la API del backend
# IMPORTANTE: Esta variable controla a qué URL se conecta el frontend
# Configuración según entorno:
# - Backend Docker local (puerto 700): http://localhost:700/api
# - Backend local sin Docker: http://localhost:5000/api
# - Producción con dominio: https://api.tudominio.com/api
# - Producción con IP: http://192.168.1.100:700/api
VITE_API_URL=http://localhost:700/api

# Puerto del servidor de desarrollo Vite (solo para npm run dev)
# No afecta a Docker (nginx siempre usa puerto 80 internamente)
VITE_PORT=3000
