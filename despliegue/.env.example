# ================================
# OVP - Variables de Entorno
# Copiar a .env y configurar valores
# ================================

# ================================
# Base de Datos PostgreSQL
# ================================
DB_NAME=ovp_database
DB_USER=postgres
DB_PASSWORD=tu_password_segura_aqui

# Puerto externo para acceder a PostgreSQL (opcional)
DB_PORT_EXTERNAL=5432

# ================================
# Backend API
# ================================
BACKEND_PORT=5000
NODE_ENV=production

# ================================
# Autenticación JWT (OBLIGATORIO)
# ================================
# Genera una clave segura: openssl rand -base64 32
JWT_SECRET=cambiar_por_una_clave_super_segura_de_al_menos_32_caracteres

# ================================
# CORS Configuration
# ================================
# Origen permitido (URL del frontend)
CORS_ORIGIN=http://localhost:3000
# Habilitar credenciales (cookies, headers de auth)
CORS_CREDENTIALS=true

# ================================
# Frontend
# ================================
FRONTEND_PORT=3000
# URL de la API que usará el frontend (ajustar según tu entorno)
# Para desarrollo local: http://localhost:700/api
# Para producción con dominio: https://api.tudominio.com/api
VITE_API_URL=http://localhost:700/api
VITE_PORT=3000
